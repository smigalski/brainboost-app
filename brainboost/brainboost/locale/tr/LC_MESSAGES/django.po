#: brainboost/core/templates/nachhilfe_anfrage.html:4
msgid "Nachhilfe Braunschweig & online | Mathe, Englisch, Deutsch | BrainBoost"
msgstr "Braunschweig ve çevrimiçi özel ders | Matematik, İngilizce, Almanca | BrainBoost"

#: brainboost/core/templates/nachhilfe_anfrage.html:6
msgid ""
"Individuelle Nachhilfe in Braunschweig und online: Mathe, Deutsch, Englisch "
"und weitere Fächer. Für Eltern, SchülerInnen und TutorInnen. Jetzt kostenlos "
"anfragen."
msgstr "Braunschweig’da ve çevrimiçi kişiye özel ders: matematik, Almanca, İngilizce ve diğer dersler. Ebeveynler, öğrenciler ve eğitmenler için. Şimdi ücretsiz talep gönderin."

#: brainboost/core/templates/nachhilfe_anfrage.html:23
msgid "Nachhilfe in Braunschweig und online"
msgstr "Braunschweig&#x27;da ve çevrimiçi özel ders"

#: brainboost/core/templates/nachhilfe_anfrage.html:24
msgid ""
"BrainBoost verbindet individuelle Nachhilfe mit klarer Organisation: Online "
"Nachhilfe und TutorInnen in Braunschweig für Mathe, Deutsch, Englisch und "
"weitere Fächer."
msgstr ""
"BrainBoost, kişiye özel özel dersleri net bir organizasyonla birleştirir: "
"Braunschweig&#x27;da matematik, Almanca, İngilizce ve diğer dersler için "
"çevrimiçi özel dersler ve öğretmenler."

